PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/task_management
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
# In production, set this to a protected PKCS#8 private-key file outside the repository.
# PASSWORD_ENCRYPTION_PRIVATE_KEY_PATH=/run/secrets/taskorbit-password-encryption.pem
# If TLS terminates at a reverse proxy, trust only that proxy/network (for example loopback).
# TRUST_PROXY=loopback
# In production, set the passkey relying-party domain and exact HTTPS frontend origin.
# WEBAUTHN_RP_ID=example.com
# WEBAUTHN_ORIGIN=https://example.com
# WEBAUTHN_RP_NAME=TaskOrbit
LOG_LEVEL=info
ENABLE_REMINDER_JOB=true
# Optional; 0 means do not automatically delete historical notifications.
NOTIFICATION_RETENTION_DAYS=0
# Optional: persistent export directory. Keep it private.
# EXPORT_ROOT=C:/private/task-management-exports
# Optional test database server (local by default; runner creates a unique database).
# TEST_MONGO_URI=mongodb://127.0.0.1:27017
